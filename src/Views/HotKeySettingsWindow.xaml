<Window x:Class="QuickSnip.Views.HotKeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="热键设置"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFFFF"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <StackPanel Margin="20">
        <TextBlock Text="按下新的组合键" Foreground="#4E5969" />

        <Border x:Name="KeyBox"
                Margin="0,10,0,0"
                Height="56"
                Background="#F7F8FA"
                BorderBrush="#E5E6EB"
                BorderThickness="1"
                CornerRadius="6"
                Focusable="True"
                FocusVisualStyle="{x:Null}">
            <TextBlock x:Name="KeyText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="19"
                       Foreground="#1D2129" />
        </Border>

        <TextBlock Margin="0,10,0,0"
                   Foreground="#86909C"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="至少包含一个修饰键（Ctrl / Alt / Shift / Win），F1–F24 例外。退格键恢复默认，Esc 关闭本窗口。" />

        <TextBlock x:Name="ErrorText"
                   Margin="0,10,0,0"
                   Foreground="#F53F3F"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="OnCancelClick" Margin="0,0,8,0" />
            <Button Content="保存" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
